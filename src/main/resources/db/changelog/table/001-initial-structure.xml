<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="001-crear-tabla-municipios" author="Hugo Cobos" dbms="postgresql">
        <createTable tableName="cat_municipios">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rfc" type="VARCHAR(13)"/>
        </createTable>
    </changeSet>


    <changeSet id="002-crear-tabla-tarifas-avanzada" author="Hugo Cobos" dbms="postgresql">
        <createTable tableName="config_tarifas">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="municipio_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tarifas_municipio" references="cat_municipios(id)"/>
            </column>
            <column name="concepto_clave" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="anio_fiscal" type="INT"/>
            <column name="descripcion" type="VARCHAR(255)"/>
            <column name="tipo_formula" type="VARCHAR(30)"/>
            <column name="parametros_regla" type="JSONB"/>
            <column name="aplica_adicional" type="BOOLEAN"/>

        </createTable>
    </changeSet>

    <changeSet id="003-crear-tablas-operativas-calculo" author="Hugo Cobos">
        <createTable tableName="solicitudes_construccion">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="predio_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_tramite" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="metros_construccion" type="DECIMAL(10, 2)"/>
            <column name="costo_presupuestado" type="DECIMAL(18, 2)"/>
            <column name="fecha_solicitud" type="DATE"/>
            <column name="estatus_tramite" type="VARCHAR(30)"/>
            <column name="dro_id" type="UUID"/>
        </createTable>

        <createIndex tableName="solicitudes_construccion" indexName="idx_construccion_predio">
            <column name="predio_id"/>
        </createIndex>


        <createTable tableName="calculos_realizados">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="clave_concepto" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="referencia_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="anio_fiscal" type="INT"/>
            <column name="monto_base" type="DECIMAL(18, 2)"/>
            <column name="impuesto_calculado" type="DECIMAL(18, 2)"/>
            <column name="recargos" type="DECIMAL(18, 2)"/>
            <column name="multas" type="DECIMAL(18, 2)"/>
            <column name="descuentos" type="DECIMAL(18, 2)"/>
            <column name="total_pagar" type="DECIMAL(18, 2)">
                <constraints nullable="false"/>
            </column>

            <column name="desglose_json" type="JSONB"/>

            <column name="fecha_calculo" type="DATETIME"/>
            <column name="usuario_calculo" type="VARCHAR(100)"/>
        </createTable>

        <createIndex tableName="calculos_realizados" indexName="idx_calculo_referencia">
            <column name="referencia_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-crear-tabla-uma" author="Hugo Cobos">
        <createTable tableName="cat_uma">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="anio" type="INT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="valor_diario" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_mensual" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_anual" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_inicio_vigencia" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin_vigencia" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <createIndex tableName="cat_uma" indexName="idx_uma_anio">
            <column name="anio"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
